# LLM Provider
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings (Voyage AI — free tier)
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_PROVIDER=voyage
EMBEDDING_DIMENSIONS=1024

# Vision LLM (complex PDF parsing) + synthesis / query LLM
VISION_MODEL=claude-sonnet-4-6
VISION_PROVIDER=anthropic
SYNTHESIS_MODEL=claude-sonnet-4-6
SYNTHESIS_PROVIDER=anthropic

# Cheap routing models (eval-gated — see src/config.py)
QUERY_CLASSIFIER_MODEL=claude-haiku-4-5
PROFILER_MODEL=claude-haiku-4-5

# Per-query background LLM judge runs on this fraction of queries (0.0–1.0)
EVAL_SAMPLE_RATE=0.1

# Qdrant (vector store)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=harrisburg_kb

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/harrisburg_kb

# Neo4j (graph database — optional; graph features degrade gracefully if absent)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Observability (LangSmith)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=harrisburg-kb
LANGCHAIN_TRACING_V2=false

# Ingestion settings
DOCS_DIR=docs
MAX_CHUNK_SIZE=1500
MIN_CHUNK_SIZE=100
CHUNK_OVERLAP=100
EXTRACTION_BATCH_SIZE=8
INGEST_WORKERS=5

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Admin
ADMIN_PASSWORD=
